# ---------------------------------------------------------------
# LLM provider (swappable). Supported: gemini | openai | anthropic | ollama
# ---------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Optional. Leave empty to use the provider default (recommended for Gemini 3.x).
LLM_TEMPERATURE=

# Gemini (Google AI Studio key)
GOOGLE_API_KEY=

# Only needed if you switch provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------
# Target site credentials (never put credentials in requirement text).
# Generated tests read them as TARGET_USERNAME / TARGET_PASSWORD env vars;
# the runner maps the selected site's variables below onto those names.
# ---------------------------------------------------------------
# SauceDemo publishes its demo credentials on its login page.
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=
# For the "Custom URL" option (e.g. your own test application)
CUSTOM_SITE_USERNAME=
CUSTOM_SITE_PASSWORD=

# ---------------------------------------------------------------
# Execution
# ---------------------------------------------------------------
# Seconds before a single pytest run is killed
EXECUTION_TIMEOUT_SECONDS=300
